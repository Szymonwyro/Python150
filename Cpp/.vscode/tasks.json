{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build & test current problem",
      "type": "shell",
      "command": "mkdir -p build && g++ -std=c++20 -O2 -Wall -Wextra -g '${file}' -o 'build/${fileBasenameNoExtension}' && './build/${fileBasenameNoExtension}'",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": ["$gcc"]
    }
  ]
}
